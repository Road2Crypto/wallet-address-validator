{
    "name": "r2c-wallet-validator",
    "version": "1.8.1",
    "description": "A comprehensive and lightweight utility to validate cryptocurrency wallet addresses across multiple chains like EVM, Solana, Bitcoin, Polkadot, and Cosmos. Maintained by Road2Crypto - The #1 Crypto Portfolio Tracker.",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "THIRD_PARTY_NOTICES.md"
    ],
    "engines": {
        "node": ">=16.9.0"
    },
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts",
        "lint": "tsc",
        "setup": "npm i && npm run build",
        "test": "npm run setup && npm run lint && jest",
        "update": "npx npm-check-updates -u --reject typescript && npm install"
    },
    "jest": {
        "transformIgnorePatterns": [
            "/node_modules/(?!@noble/hashes/)"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Road2Crypto/wallet-address-validator.git"
    },
    "homepage": "https://github.com/Road2Crypto/wallet-address-validator#readme",
    "bugs": {
        "url": "https://github.com/Road2Crypto/wallet-address-validator/issues"
    },
    "keywords": [
        "wallet",
        "address",
        "validator",
        "cryptocurrency",
        "crypto",
        "blockchain",
        "EVM",
        "Solana",
        "Bitcoin",
        "Cosmos",
        "Polkadot",
        "Cardano",
        "ethereum",
        "btc",
        "sol",
        "xrp",
        "web3",
        "check",
        "format",
        "verify"
    ],
    "author": {
        "name": "Road2Crypto",
        "url": "https://road2crypto.com"
    },
    "license": "MIT",
    "devDependencies": {
        "@noble/hashes": "2.4.0",
        "@babel/core": "8.0.7",
        "@babel/preset-env": "8.0.7",
        "@babel/preset-typescript": "8.0.7",
        "@types/jest": "30.0.0",
        "@types/node": "26.6.5",
        "babel-jest": "30.5.2",
        "jest": "30.5.2",
        "tsup": "9.0.0",
        "typescript": "6.0.3"
    }
}
